# Optional account build configuration. With all three absent, legacy personal
# connection mode remains enabled. dev:stack supplies these automatically.
# Never put a Supabase secret/service_role or an upstream model key here.
# Native devices require reachable HTTPS URLs, not the phone's localhost.
# VITE_SUPABASE_URL=https://your-auth-service.example
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key
# VITE_ACCOUNT_API_URL=https://your-account-api.example
