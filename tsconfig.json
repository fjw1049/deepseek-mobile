{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "noUnusedLocals": true,
    "paths": {
      "@runtime-audio-recorder": [
        "../deepseek-tui-py-main/packages/workbench/src/renderer/src/hooks/use-audio-recorder.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "capacitor.config.ts",
    "e2e",
    "playwright.config.ts"
  ]
}
