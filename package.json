{
  "name": "deepseek-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:account": "node scripts/dev-stack.mjs --setup-only",
    "test:account": "node scripts/test-account-stack.mjs",
    "test:account-ui": "node scripts/test-account-ui.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "native:sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "format": "prettier --write src tests e2e *.ts",
    "test:e2e": "playwright test",
    "android:apk": "npm run native:sync && cd android && ./gradlew :app:assembleDebug",
    "android:bundle": "npm run native:sync && cd android && ./gradlew :app:bundleRelease",
    "runtime:start": "node scripts/start-runtime.mjs",
    "live:preview": "node scripts/start-live-preview.mjs",
    "live:check": "node scripts/start-live-preview.mjs --check",
    "companion:build": "node scripts/build-companion.mjs",
    "pretest:e2e": "npm run companion:build",
    "preruntime:start": "npm run companion:build",
    "prelive:preview": "npm run companion:build"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.119.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.7"
  }
}
